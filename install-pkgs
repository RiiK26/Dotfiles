    xorg-xwayland
    yay
    zip
    zoom
)

# 3. Install Packages
echo "Beginning installation of ${#PACKAGES[@]} packages..."
# Using --needed ensures we safely skip packages that are already up to date (like the linux kernel and grub)
yay -S --needed --noconfirm "${PACKAGES[@]}"

# 4. Flatpak Packages
FLATPAK_PACKAGES=(
    # Add your flatpak app IDs here (e.g. com.spotify.Client)
    com.discordapp.Discord
    org.onlyoffice.desktopeditors
    org.videolan.VLC
    org.vinegarhq.Sober
)

if [ ${#FLATPAK_PACKAGES[@]} -gt 0 ]; then
    echo "Beginning flatpak installation..."
    # Ensure flathub repository is enabled
    sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    
    # Install the flatpak packages
    flatpak install -y flathub "${FLATPAK_PACKAGES[@]}"
fi

echo "=========================================="
echo "Package installation complete!"
