#!/usr/bin/env bash

set -e

echo "=========================================="
echo "    Dotfiles Package Installation Script"
echo "=========================================="

# 1. Bootstrap yay if it is not installed
if ! command -v yay &> /dev/null; then
    echo "yay is not installed. Bootstrapping yay from AUR..."
    # Ensure git and base-devel are installed first
    sudo pacman -S --needed --noconfirm git base-devel
    
    # Clone yay-bin and build it
    git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin
    cd /tmp/yay-bin
    makepkg -si --noconfirm
    cd -
    rm -rf /tmp/yay-bin
    echo "yay has been successfully installed!"
else
    echo "yay is already installed."
fi

# 2. Package List
PACKAGES=(
    7zip
    adobe-source-han-sans-cn-fonts
    alsa-firmware
