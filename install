#!/usr/bin/env bash

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Installing dotfiles from $DIR"
echo "=========================================="

# 1. Recursive symlink function for the home directory
function link_target {
    local src="$1"
    local dest="$2"
    
    # Check if the file is ignored by git, if so, skip it completely
    if git -C "$DIR" check-ignore -q "$src" 2>/dev/null; then
        echo "Skipping ignored file/directory: $(basename "$src")"
        return
    fi
    
    # If the destination exists and is not a symlink
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        # If both source and destination are directories, recurse into them
        if [ -d "$dest" ] && [ -d "$src" ]; then
            for item in "$src"/* "$src"/.[!.]* "$src"/..?*; do
                # Skip if empty expansion
                [ -e "$item" ] || continue
                link_target "$item" "$dest/$(basename "$item")"
            done
            return
        else
            echo "Warning: $dest already exists and is a regular file/dir. Backing up to $dest.bak"
            mv "$dest" "${dest}.bak"
        fi
    fi
    
    # Create parent directory in the destination if it doesn't exist
    mkdir -p "$(dirname "$dest")"
    
    echo "Symlinking $(basename "$src") -> $dest"
    ln -sfn "$src" "$dest"
}

echo "--> Setting up user configurations (~/)"
for item in "$DIR/~"/* "$DIR/~"/.[!.]* "$DIR/~"/..?*; do
    [ -e "$item" ] || continue
    link_target "$item" "$HOME/$(basename "$item")"
done

# 2. System configurations (/etc/)
echo ""
echo "--> Setting up system configurations (/etc/)"
if [ -d "$DIR/etc" ]; then
    echo "This step requires root privileges to copy files to /etc/"
    # Copy files, preserving directories but changing ownership to root
    sudo cp -r "$DIR"/etc/. /etc/
    sudo chown -R root:root /etc/sddm.conf.d/default.conf 2>/dev/null || true
    echo "System configurations (/etc/) copied successfully."
fi

# 3. System configurations (/usr/)
echo ""
echo "--> Setting up system configurations (/usr/)"
if [ -d "$DIR/usr" ]; then
    echo "This step requires root privileges to copy files to /usr/"
    # Copy files, preserving directories but changing ownership to root
    sudo cp -r "$DIR"/usr/. /usr/
    echo "System configurations (/usr/) copied successfully."
fi

echo "=========================================="
echo "Dotfiles installation complete!"
