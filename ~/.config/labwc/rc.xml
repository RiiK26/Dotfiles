<labwc_config>
  <theme>
    <name>Aura Midnight</name>
    <cornerRadius>8</cornerRadius>
    <font name="sans" size="10" />
    <icon>Papirus-Dark</icon>
    <dropShadows>yes</dropShadows>
  </theme>
  <!-- HARDWARE SETTINGS (MOUSE & TOUCHPAD) -->
  <libinput>
    <device category="touchpad">
      <!-- Revert scrolling for touchpad -->
      <naturalScroll>yes</naturalScroll>
    </device>
    <!-- Default scrolling for mouse (naturalScroll=no) -->
  </libinput>
  <keyboard>
    <default />
    <numlock>on</numlock>
    <!-- Lights up -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="sh -c '~/.local/bin/brightness.sh StepUp'" />
    </keybind>
    <!-- Lights down -->
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="sh -c '~/.local/bin/brightness.sh StepDown'" />
    </keybind>
    <!-- Turn up the volume -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="sh -c '~/.local/bin/volume.sh StepUp'" />
    </keybind>
    <!-- Turn down the volume -->
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="sh -c '~/.local/bin/volume.sh StepDown'" />
    </keybind>
    <!-- Mute -->
    <keybind key="XF86AudioMute">
      <action name="Execute" command="sh -c '~/.local/bin/volume.sh ToggleMute'" />
    </keybind>
    <!-- Open Terminal (Ctrl + Alt + T) -->
    <keybind key="C-A-t">
      <action name="Execute" command="qterminal" />
    </keybind>
    <!-- W is super button -->
    <keybind key="W-e">
      <action name="Execute" command="pcmanfm-qt" />
    </keybind>
    <keybind key="W-f">
      <action name="Execute" command="firefox" />
    </keybind>
    <keybind key="W-a">
      <action name="Execute" command="antigravity-ide" />
    </keybind>
    <keybind key="W-c">
      <action name="Execute" command="code-oss -n" />
    </keybind>
    <keybind key="F5">
      <action name="Reconfigure" />
    </keybind>
    <keybind key="A-Escape">
      <action name="Close" />
    </keybind>
    <keybind key="W-Print">
      <action name="Execute" command="~/.local/bin/screenshot.sh custom" />
    </keybind>
    <!-- Single shortcut must below combination shortcut -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="sh -c 'killall nwg-menu || nwg-menu -k'" />
    </keybind>
    <!-- Screenshot Keybinds -->
    <keybind key="Print" onRelease="yes">
      <action name="Execute" command="~/.local/bin/screenshot.sh full" />
    </keybind>
    <repeatDelay>300</repeatDelay>
  </keyboard>
  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="some-custom-menu" />
      </mousebind>
    </context>
  </mouse>
  <placement>
    <policy>center</policy>
  </placement>
  <!--windowRules>
  </windowRules> -->
</labwc_config>