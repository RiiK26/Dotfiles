{
    "workbench.startupEditor": "none",
    "window.restoreWindows": "none",
    "workbench.editor.empty.hint": "hidden",
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "chat.mcp.serverSampling": {},
    "update.mode": "none",
    "update.titleBar": false,
    "update.showReleaseNotes": false,
    "editor.experimental.treeSitterTelemetry": false,
    "editor.experimental.preferTreeSitter.css": false,
    "editor.experimental.preferTreeSitter.ini": false,
    "editor.experimental.preferTreeSitter.regex": false,
    "editor.experimental.preferTreeSitter.typescript": false,
    "search.experimental.useIgnoreFilesInFindFiles": false,
    "telemetry.editStats.details.enabled": false,
    "telemetry.editStats.showDecorations": false,
    "telemetry.editStats.showStatusBar": false,
    "telemetry.editStats.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.enabled": false,
    "network.meteredConnection": "on",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "github.copilot.chat.claudeOpus5Prompt.enabled": true,
    "editorconfig.template": "~/Templates/.editorconfig",
    "clangd.arguments": [
        "--compile-commands-dir=build"
    ],
    "files.associations": {
        ".clang-format": "yaml",
        ".clangd": "yaml",
        ".editorconfig": "ini",
        "*dump.cs": "plaintext",
    },
    "search.exclude": {
        "**/*dump.cs": true,
    },
    "files.watcherExclude": {
        "**/*dump.cs": true,
    },
    "[plaintext]": {
        "editor.formatOnSave": false
    },
    "editor.formatOnSave": true,
    "terminal.integrated.initialHint": false,
    "workbench.editor.useModal": "off",
    "extensions.allowOpenInModalEditor": true,
    "editor.fontFamily": "'Droid Sans Mono', 'monospace', monospace, 'Nerd Font', 'JetBrainsMono Nerd Font'",
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "top",
    "editor.fontSize": 16,
    "chat.viewSessions.orientation": "stacked",
    "workbench.secondarySideBar.showLabels": false,
    "workbench.secondarySideBar.defaultVisibility": "visible",
    "security.workspace.trust.startupPrompt": "always",
    "chat.tips.enabled": false,
}