{
    "[plaintext]": {
        "editor.formatOnSave": false,
        "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false
        },
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "chat.mcp.serverSampling": {},
    "chat.tips.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--fallback-style=webkit",
        "--log=verbose",
        "--pch-storage=memory",
        "--query-driver=/usr/bin/x86_64-w64-mingw32-g*",
    ],
    "clangd.enableCodeCompletion": true,
    "clangd.enableHover": false,
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false,
    "cmake.enableAutomaticKitScan": false,
    "editorconfig.generateAuto": false,
    "editorconfig.template": "${userHome}/Templates/.editorconfig",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.experimental.preferTreeSitter.css": false,
    "editor.experimental.preferTreeSitter.ini": false,
    "editor.experimental.preferTreeSitter.regex": false,
    "editor.experimental.preferTreeSitter.typescript": false,
    "editor.experimental.treeSitterTelemetry": false,
    "editor.fontFamily": "'Droid Sans Mono', 'monospace', monospace, 'Nerd Font', 'JetBrainsMono Nerd Font'",
    "editor.fontSize": 16,
    "editor.formatOnSave": true,
    "editor.inlineSuggest.edits.showLongDistanceHint": false,
    "editor.inlineSuggest.enabled": false,
    "editor.inlineSuggest.experimental.emptyResponseInformation": false,
    "editor.inlineSuggest.edits.renderSideBySide": "never",
    "editor.inlineSuggest.edits.allowCodeShifting": "never",
    "editor.inlineSuggest.showToolbar": "never",
    "editor.inlineSuggest.suppressInSnippetMode": false,
    "editor.inlineSuggest.syntaxHighlightingEnabled": false,
    "editor.inlineSuggest.triggerCommandOnProviderChange": false,
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.screenReaderAnnounceInlineSuggestion": false,
    "editor.suggest.filterGraceful": false,
    "editor.suggest.showClasses": false,
    "editor.suggest.showColors": true,
    "editor.suggest.showConstants": false,
    "editor.suggest.showConstructors": false,
    "editor.suggest.showCustomcolors": false,
    "editor.suggest.showDeprecated": false,
    "editor.suggest.showEnumMembers": false,
    "editor.suggest.showEnums": false,
    "editor.suggest.showEvents": false,
    "editor.suggest.showFiles": false,
    "editor.suggest.showFields": false,
    "editor.suggest.showFolders": false,
    "editor.suggest.showFunctions": false,
    "editor.suggest.showIcons": false,
    "editor.suggest.showInlineDetails": false,
    "editor.suggest.showInterfaces": false,
    "editor.suggest.showIssues": false,
    "editor.suggest.showKeywords": false,
    "editor.suggest.showMethods": false,
    "editor.suggest.showModules": false,
    "editor.suggest.showOperators": false,
    "editor.suggest.showReferences": false,
    "editor.suggest.showProperties": false,
    "editor.suggest.showSnippets": false,
    "editor.suggest.showTypeParameters": false,
    "editor.suggest.showStructs": false,
    "editor.suggest.showUnits": false,
    "editor.suggest.showUsers": false,
    "editor.suggest.showValues": false,
    "editor.suggest.showVariables": false,
    "editor.suggest.showWords": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.trimWhitespaceOnDelete": true,
    "extensions.allowOpenInModalEditor": true,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "explorer.confirmDragAndDrop": false,
    "files.associations": {
        "*dump.cs": "plaintext",
        ".clang-format": "yaml",
        ".clangd": "yaml",
        ".editorconfig": "ini",
        ".clang-tidy": "yaml",
    },
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/*dump.cs": true
    },
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "git.enableSmartCommit": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "scminput": false,
        "markdown": false
    },
    "github.copilot.nextEditSuggestions.eagerness": "low",
    "github.copilot.chat.claudeOpus5Prompt.enabled": true,
    "json.format.keepLines": false,
    "merge-conflict.autoNavigateNextConflict.enabled": true,
    "network.meteredConnection": "on",
    "python.languageServer": "Default",
    "search.exclude": {
        "**/*dump.cs": true
    },
    "search.experimental.useIgnoreFilesInFindFiles": false,
    "security.workspace.trust.startupPrompt": "always",
    "telemetry.editStats.details.enabled": false,
    "telemetry.editStats.enabled": false,
    "telemetry.editStats.showDecorations": false,
    "telemetry.editStats.showStatusBar": false,
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.initialHint": false,
    "update.mode": "none",
    "update.showReleaseNotes": false,
    "update.titleBar": false,
    "window.restoreWindows": "none",
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "top",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.useModal": "off",
    "workbench.secondarySideBar.defaultVisibility": "visible",
    "workbench.secondarySideBar.showLabels": false,
    "workbench.startupEditor": "none",
}